menu "MDM Configuration"

    config MDM_LOG_TOPIC
        string "MQTT topic for log messages"
        default "iotsupport/logsink"

    config MDM_LOG_TASK_STACK_SIZE
        int "Stack size for log manager task"
        default 4096

    config MDM_LOG_TASK_CORE_ID
        int "Core ID for log manager task"
        default 0

    # Device identity used for Home Assistant MQTT discovery. Moved here from
    # esp-mqtt-support so the MQTT layer stays transport-only; ApplicationBase
    # feeds these into MQTTConfiguration::device by default, and concrete
    # applications may override get_device_configuration() to vary them (e.g.
    # per hardware version).
    config MQTT_DEVICE_MANUFACTURER
        string "MQTT device manufacturer"

    config MQTT_DEVICE_MODEL
        string "MQTT device model"

    config MQTT_DEVICE_MODEL_ID
        string "MQTT device model ID"

endmenu
